{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "Simple mod to ignore registry sync mismatches in Fabric API",
	"authors": [
		"ILikeFood971"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/regsyncfix",
		"sources": "https://github.com/ILikeFood971/RegSyncFix"
	},
	"license": "MIT",
	"icon": "assets/regsyncfix/icon.png",
	"environment": "*",
	"entrypoints": {
		"mixinsquared": [
			"me.ilikefood971.LegacySyncSenderCanceller"
		]
	},
	"mixins": [
		"regsyncfix.mixins.json"
	],
	"depends": {
		"fabricloader": "${loader}",
		"minecraft": "${minecraft}",
		"fabric-registry-sync-v0": "*"
	}
